{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Visual Agent Workspace (demo workspace)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/.vscode/visual-agent.local.code-workspace"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: dev:prepare"
    }
  ]
}
